{
  "name": "@haowei0520/cheers-workbench-sdk",
  "version": "0.1.0",
  "description": "SDK and packer for sandboxed Cheers Workbench extensions",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
