{
  "version": 1,
  "workflows": {
    "ci": {
      "global_patterns": [
        ".github/ci-paths.json",
        ".github/workflows/ci.yml",
        "VERSION",
        "scripts/ci_tool.py",
        "scripts/tests/test_ci_tool.py",
        "scripts/tests/test_version_control.py",
        "scripts/version_control.py"
      ],
      "lanes": {
        "gateway": [
          ".cargo/config.toml",
          "scripts/check-sqlx-queries.py",
          "scripts/tests/test_sqlx_queries.py",
          "server/**",
          "scripts/sqlx-offline.sh",
          "design-system/a2ui-catalog.json",
          "frontend/src/features/chat/workbench/lens/a2ui/example.a2ui.json",
          "fixtures/locator/**",
          "fixtures/workbench/**",
          "packages/cheers-acp-connector-rs/bridge-protocol/**",
          "packages/cheers-interactive-core/**",
          "packages/cheers-mcp-server/**"
        ],
        "frontend": [
          "frontend/**",
          "design-system/**",
          "extensions/**",
          "fixtures/workbench/**",
          "server/src/resource/mod.rs",
          "packages/cheers-canvas-runtime/**",
          "packages/cheers-workbench-sdk/**",
          "scripts/build-extension-catalog.mjs",
          "scripts/check-design-system.mjs",
          "scripts/lib/extension-catalog.test.mjs",
          "website/**"
        ],
        "plugin": [
          "packages/cheers-acp-connector-rs/**",
          "packages/cheers-mcp-server/**",
          "packages/cheers-interactive-core/**",
          "design-system/a2ui-catalog.json",
          "frontend/src/features/chat/workbench/lens/a2ui/example.a2ui.json",
          "fixtures/locator/**"
        ],
        "desktop": [
          "apps/macos/**"
        ],
        "ios": [
          "apps/ios/**",
          "design-system/**",
          "scripts/check-design-system.mjs",
          "scripts/check-pbxproj.py"
        ]
      }
    },
    "cd": {
      "global_patterns": [
        ".dockerignore",
        ".github/ci-paths.json",
        ".github/workflows/cd.yml",
        "VERSION",
        "deploy/production/deploy.sh",
        "docker-compose.yml.template",
        "scripts/ci_tool.py",
        "scripts/version_control.py",
        "scripts/verify-deploy-contract.sh"
      ],
      "lanes": {
        "gateway": [
          "server/**",
          ".cargo/config.toml",
          "packages/cheers-acp-connector-rs/bridge-protocol/**",
          "packages/cheers-interactive-core/**",
          "packages/cheers-mcp-server/**",
          "design-system/a2ui-catalog.json",
          "frontend/src/features/chat/workbench/lens/a2ui/example.a2ui.json",
          "fixtures/locator/**",
          "fixtures/workbench/**"
        ],
        "frontend": [
          "frontend/**",
          "design-system/**",
          "extensions/**",
          "packages/cheers-canvas-runtime/**",
          "packages/cheers-workbench-sdk/**",
          "scripts/build-extension-catalog.mjs",
          "scripts/lib/extension-catalog.test.mjs",
          "website/**"
        ]
      }
    }
  }
}
