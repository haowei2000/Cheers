{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window capabilities: native notifications, in-app updates (check/install + the relaunch that follows), and the local desktop command surface, plus the shell permission for the bundled connector sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart",
    "allow-desktop-commands",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/cce-acp-connector",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
