{
  "id": "cheers-team-ops",
  "version": 1,
  "title": "Team ops",
  "items": [
    {
      "id": "servers",
      "title": "Servers",
      "source": {
        "kind": "fs",
        "path": "ops/servers.yaml"
      },
      "view": "builtin:table",
      "config": {
        "columns": [
          {
            "key": "name",
            "label": "Server"
          },
          {
            "key": "env",
            "label": "Env",
            "options": [
              "prod",
              "staging",
              "dev"
            ]
          },
          {
            "key": "status",
            "label": "Status",
            "options": [
              "up",
              "degraded",
              "down",
              "retired"
            ]
          },
          {
            "key": "owner",
            "label": "Owner"
          },
          {
            "key": "notes",
            "label": "Notes"
          }
        ]
      }
    },
    {
      "id": "assets",
      "title": "Assets",
      "source": {
        "kind": "fs",
        "path": "ops/assets.yaml"
      },
      "view": "builtin:table",
      "config": {
        "columns": [
          {
            "key": "asset",
            "label": "Asset"
          },
          {
            "key": "kind",
            "label": "Kind",
            "options": [
              "domain",
              "cert",
              "license",
              "account",
              "hardware"
            ]
          },
          {
            "key": "owner",
            "label": "Owner"
          },
          {
            "key": "renewal",
            "label": "Renews"
          }
        ]
      }
    },
    {
      "id": "oncall",
      "title": "On-call",
      "source": {
        "kind": "fs",
        "path": "ops/oncall.yaml"
      },
      "view": "builtin:kanban"
    }
  ],
  "seed": {
    "ops/servers.yaml": [
      {
        "name": "example-box",
        "env": "prod",
        "status": "up",
        "owner": "",
        "notes": "replace me"
      }
    ],
    "ops/assets.yaml": [
      {
        "asset": "example.com",
        "kind": "domain",
        "owner": "",
        "renewal": ""
      }
    ],
    "ops/oncall.yaml": {
      "columns": [
        {
          "name": "Watch",
          "items": []
        },
        {
          "name": "Investigating",
          "items": []
        },
        {
          "name": "Resolved",
          "items": []
        }
      ]
    },
    "prompts/ops-conventions.md": "# Ops conventions\n\n- Inventory lives in `ops/servers.yaml`; keep `status` honest — alerts read it.\n- Anything with an expiry (domains, certs, licenses) goes in `ops/assets.yaml` with `renewal` as YYYY-MM-DD.\n- Incidents move across `ops/oncall.yaml`: Watch → Investigating → Resolved.\n"
  },
  "pin": [
    "prompts/ops-conventions.md"
  ],
  "panels": [
    {
      "id": "roster",
      "title": "Roster",
      "source": {
        "kind": "resource",
        "verb": "channel.members",
        "pick": "members"
      },
      "view": "builtin:table",
      "config": {
        "columns": [
          {
            "key": "display_name",
            "label": "Name"
          },
          {
            "key": "member_type",
            "label": "Type"
          },
          {
            "key": "status_text",
            "label": "Status"
          }
        ]
      }
    }
  ]
