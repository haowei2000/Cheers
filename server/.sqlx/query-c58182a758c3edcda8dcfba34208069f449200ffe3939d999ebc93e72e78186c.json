{
  "db_name": "PostgreSQL",
  "query": "SELECT b.bot_id, COALESCE(b.display_name,b.username) AS bot_name, b.processor_name,\n                b.processor_privacy_url, b.processor_data_use, b.processor_policy_version\n         FROM channel_memberships m JOIN bot_accounts b ON b.bot_id = m.member_id\n         WHERE m.channel_id = $1 AND m.member_type = 'bot' AND b.external_processor = TRUE",
