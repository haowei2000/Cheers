  "query": "SELECT channel_id,bot_id,mode,scope,debounce_seconds,min_interval_seconds,max_evaluations_per_hour,batch_size,confidence_threshold::float8 AS confidence_threshold,last_evaluated_seq,policy\n        FROM channel_bot_monitoring\n        WHERE mode <> 'off' AND (next_eligible_at IS NULL OR next_eligible_at <= NOW())\n        ORDER BY COALESCE(next_eligible_at,created_at) LIMIT 20",
