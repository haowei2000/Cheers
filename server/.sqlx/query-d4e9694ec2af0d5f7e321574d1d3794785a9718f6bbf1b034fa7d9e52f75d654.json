  "db_name": "PostgreSQL",
  "query": "SELECT h.device_name, h.status, h.revoked_at,\n                COALESCE(b.display_name, b.username) AS bot_name\n           FROM connector_hosts h\n           JOIN bot_accounts b ON b.bot_id = h.bot_id\n          WHERE h.host_id = $1 AND h.bot_id = $2",
