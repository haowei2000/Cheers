  "db_name": "PostgreSQL",
  "query": "SELECT path, version, is_dir, LENGTH(content)::bigint AS size_bytes,\n                created_at, updated_at\n         FROM context_files\n         WHERE channel_id = $1\n           AND ($2 = '' OR path = $2 OR left(path, char_length($2) + 1) = $2 || '/')\n         ORDER BY is_dir DESC, path ASC",
