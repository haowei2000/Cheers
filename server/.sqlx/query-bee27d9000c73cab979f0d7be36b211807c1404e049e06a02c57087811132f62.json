  "query": "SELECT i.host_id, i.bot_id, b.is_disabled\n         FROM connector_hosts i\n         JOIN bot_accounts b ON b.bot_id = i.bot_id\n         WHERE i.host_id = $1 AND i.credential_hash = $2 AND i.status = 'active'\n           AND i.revoked_at IS NULL",
